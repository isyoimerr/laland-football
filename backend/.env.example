# ─── Entorno ───────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001

# ─── Base de datos (MySQL) ─────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_NAME=laland_football
DB_USER=root
DB_PASSWORD=

# ─── JWT ──────────────────────────────────────────────────────────────────────
JWT_SECRET=cambia_esto_por_un_secreto_seguro_minimo_32_chars
JWT_REFRESH_SECRET=otro_secreto_diferente_minimo_32_chars
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d

# ─── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:5173

# ─── Rate limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=10

# ─── Telegram (opcional) ──────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=tu_token_de_bot_aqui
TELEGRAM_CHAT_ID=tu_chat_id_aqui
